# Server-side only. Never use NEXT_PUBLIC_ for this key.
# Get a key from https://aistudio.google.com/app/apikey
# Copy to .env.local for local dev; set in Vercel project env vars for deploys.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model override (must support text+image input and JSON output).
# Default: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 2 (Step 7) — server DB (Neon). Optional: without it the app runs in
# local-only mode (IndexedDB), exactly as before.
# Get one from https://neon.com — placeholder until the account exists.
DATABASE_URL=your-neon-postgres-connection-string

# Phase 2 (Step 7) — Better Auth, magic-link sign-in (the only human
# sign-in; PHASE-2.md §3.6). Generate a secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here
# Base URL of the app. Local dev port is 3200 (see "npm run dev");
# on Vercel set it to the production URL.
BETTER_AUTH_URL=http://localhost:3200
# Sign-in email via Resend. EMAIL_FROM must be a sender Resend accepts:
#   - instant testing:  EMAIL_FROM="AI Menu Digitizer <onboarding@resend.dev>"
#     (delivers only to the email address of your Resend account itself)
#   - real sending:     verify a domain you own in Resend — add every DKIM/
#     SPF record it shows (DMARC recommended; active in ~5–15 min), then use
#     an address on that domain. A *.vercel.app hostname can't be verified:
#     you don't control its DNS, and Resend requires a domain you own.
# The From domain does not have to match the website's domain, but Resend
# recommends links match the From domain to avoid spam filters (tests: fine).
# On the sending domain, disable click tracking — rewritten links can break
# magic links. Free tier: 100 emails/day, 3,000/month.
# Without RESEND_API_KEY, dev prints links to the server console and
# production fails honestly instead of silently dropping links.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="AI Menu Digitizer <login@yourdomain.com>"
