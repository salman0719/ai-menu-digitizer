# Server-side only. Never use NEXT_PUBLIC_ for either key.
# Copy to .env.local for local dev; set in Vercel project env vars for deploys.
#
# Two image-extraction vendors are supported. Gemini stays the default; add a
# Groq key to enable Groq and automatic failover between them.
# Get the Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model override (must support text+image input and JSON output).
# Default: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# Get the Groq key from https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key-here
# Default: qwen/qwen3.8-27b (Groq reads at most 3 page images per request and
# does not read HEIC/HEIF; those pages go to Gemini when it is configured).
# GROQ_MODEL=qwen/qwen3.8-27b
#
# Which vendor goes first: "gemini" (default) or "groq".
# AI_PROVIDER=gemini
# Optional fallback vendor. Unset means "the other vendor" (so a second key
# alone buys failover); set to "none" to disable failover and pin one vendor.
# AI_FALLBACK_PROVIDER=none

# A1 — the dashboard assistant (Cloudflare Workers AI, server-side only).
# Create an API token with Workers AI permission at
# https://dash.cloudflare.com/profile/api-tokens and copy the account id from
# the Workers AI dashboard. Without both values the Assistant tab explains
# that it is not configured; nothing else in the app is affected.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
# Default: @cf/zai-org/glm-4.7-flash (measured in the A0 spike; the model
# needs `chat_template_kwargs.enable_thinking=false`, which the server sends).
# CLOUDFLARE_DEFAULT_AI_MODEL=@cf/zai-org/glm-4.7-flash
# Cost brakes. The account cap is per UTC month; the daily ceiling covers all
# accounts together because the Workers AI free allocation is shared.
# ASSISTANT_MONTHLY_MESSAGE_CAP=300
# ASSISTANT_DAILY_CALL_CEILING=500

# A4 — feature flags (server-side only; no secret values here). When this
# variable is unset or blank, nothing is released: both the Assistant and
# proposal review are hidden from everyone. They can be checked by URL preview:
#   /assistant?ff=assistant             help only
#   /assistant?ff=assistantProposals    help plus menu-change proposals
# A present value replaces that default. Unknown flags and invalid JSON are
# ignored, so the registry defaults stand. Signed-in accounts only.
#
# Shape: FEATURE_FLAGS={"<flag>":{"enabled":true|false,"disabled":true,
# "emails":["..."],"userIds":["..."],"preview":true|false}}
# - enabled   release to every signed-in account
# - disabled  emergency stop; overrides every other field
# - emails    allowlisted account emails (case-insensitive)
# - userIds   allowlisted Better Auth user ids
# - preview   allow ?ff=<flag> preview links for signed-in accounts
#
# Examples (copy the line you need; one FEATURE_FLAGS value only):
# Release proposals to one account (the Assistant comes with them):
# FEATURE_FLAGS={"assistantProposals":{"emails":["owner@cafe.test"]}}
# Release proposals to everyone:
# FEATURE_FLAGS={"assistantProposals":{"enabled":true}}
# Release the help Assistant without proposals:
# FEATURE_FLAGS={"assistant":{"enabled":true}}
# Stop the assistant everywhere (proposals cannot outlive it):
# FEATURE_FLAGS={"assistant":{"disabled":true}}
# Clear a preview cookie in the browser: load any page with ?ff=off

# Phase 2 (Step 7) — server DB (Neon). Optional: without it the app runs in
# local-only mode (IndexedDB), exactly as before.
# Get one from https://neon.com — placeholder until the account exists.
DATABASE_URL=your-neon-postgres-connection-string

# Phase 2 (Step 7) — Better Auth, magic-link sign-in (the only human
# sign-in; PHASE-2.md §3.6). Generate a secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here
# Base URL of the app. Local dev port is 3200 (see "npm run dev");
# on Vercel set it to the production URL.
BETTER_AUTH_URL=http://localhost:3200
# Sign-in email via Resend. EMAIL_FROM must be a sender Resend accepts:
#   - instant testing:  EMAIL_FROM="Eateryo <onboarding@resend.dev>"
#     (delivers only to the email address of your Resend account itself)
#   - real sending:     verify a domain you own in Resend — add every DKIM/
#     SPF record it shows (DMARC recommended; active in ~5–15 min), then use
#     an address on that domain. A *.vercel.app hostname can't be verified:
#     you don't control its DNS, and Resend requires a domain you own.
# The From domain does not have to match the website's domain, but Resend
# recommends links match the From domain to avoid spam filters (tests: fine).
# On the sending domain, disable click tracking — rewritten links can break
# magic links. Free tier: 100 emails/day, 3,000/month.
# Without RESEND_API_KEY, dev prints links to the server console and
# production fails honestly instead of silently dropping links.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Eateryo <login@yourdomain.com>"

# Step 11 — launch operations (all optional locally, required for a real
# launch; see docs/launch-runbook.md).
# Where failure and volume alerts are emailed. Without it, alerts exist only
# as structured log lines (event=ops_alert).
OPS_ALERT_EMAIL=ops@yourdomain.com
# Shown on /privacy and /terms. Left unset, those pages say no address is
# configured instead of publishing a mailbox nobody reads.
CONTACT_EMAIL=hello@yourdomain.com
# Bearer secret for the maintenance purge (/api/cron/retention). Only needed
# if you run that route yourself or add a scheduler: automatic scheduling is
# parked (Vercel cron needs a paid plan), and without this variable the route
# refuses every caller. Generate with: openssl rand -hex 32
# CRON_SECRET=your-cron-secret-here

# The free-launch cost brake: extractions allowed per account per UTC month.
# EXTRACTION_MONTHLY_CAP=150
# Provider token prices (USD per million tokens), per vendor. Both rates for
# a vendor are needed before its calls can be priced; unpriced calls make the
# spend panel report cost as unavailable instead of guessing.
# Gemini: https://ai.google.dev/gemini-api/docs/pricing
# GEMINI_INPUT_USD_PER_MTOK=0.30
# GEMINI_OUTPUT_USD_PER_MTOK=2.50
# Groq: https://console.groq.com/docs/models
# GROQ_INPUT_USD_PER_MTOK=0.80
# GROQ_OUTPUT_USD_PER_MTOK=4.00

# How far back the maintenance purge keeps orders when it is run.
# ORDER_RETENTION_DAYS=90
